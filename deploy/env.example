# Copy this file to deploy/.env and edit values for your environment.

# Runtime mode:
# - go-run: run legacy master/worker via `go run`
# - bin: run prebuilt binaries (recommended for lightweight multi-machine demos)
RUN_MODE=go-run

# Toolchain / binaries
GO_BIN=/Users/empty/.g/go/bin/go
MASTER_BIN=./bin/legacy-master
WORKER_BIN=./bin/legacy-worker

# Cluster topology
MASTER_HOST=127.0.0.1
MASTER_PORT=11340
# Used by workers. If empty, worker uses local master via --port only.
MASTER_ADDR=127.0.0.1:11340
# Hostname/IP that worker advertises to master (without port).
# For single-machine keep empty; for multi-machine set per worker node.
ADVERTISE_HOST=
WORKERS=3
REDUCERS=1

# Job arguments
IN_RAM=false
PLUGIN_PATH=cmd/wc.so
FORCE_REBUILD_PLUGIN=0
INPUT_GLOB=txt/*.txt
RUN_DIR=.run/multi-node

# SSH fanout settings
SSH_USER=ubuntu
SSH_PORT=22
SSH_KEY=~/.ssh/id_rsa
# comma-separated worker hosts
WORKER_HOSTS=10.0.0.12,10.0.0.13
# path to repo on remote host
REMOTE_ROOT=~/mrkit-go
